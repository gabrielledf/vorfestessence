# WhatsApp que receberá os comprovantes de pagamento (DDI + DDD + número, somente dígitos).
# Exemplo: 5551999999999
NEXT_PUBLIC_ESSENCE_WHATSAPP=5551999999999

# Evolution API hospedada no Render e instância conectada ao WhatsApp.
EVOLUTION_API_URL=https://sua-evolution-api.onrender.com
EVOLUTION_API_KEY=sua-chave-da-evolution
EVOLUTION_INSTANCE=nome-da-instancia

# Monitor diário da conexão (Vercel Cron) e alerta por e-mail (Resend).
# ALERT_EMAIL_FROM deve usar um remetente/domínio validado na sua conta Resend.
CRON_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-16-caracteres
RESEND_API_KEY=re_xxxxxxxxx
ALERT_EMAIL_FROM=Essence Vorfest <alertas@seu-dominio.com>

# O Neon conectado pela Vercel fornece automaticamente uma dessas variáveis.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Login da área administrativa. Não use a senha da conta Google.
ESSENCE_ADMIN_PASSWORD=crie-uma-senha-forte-exclusiva-para-o-site
ESSENCE_ADMIN_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio
