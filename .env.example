# WhatsApp que receberá os comprovantes de pagamento (DDI + DDD + número, somente dígitos).
# Exemplo: 5551999999999
NEXT_PUBLIC_ESSENCE_WHATSAPP=5551999999999

# Backend do site: URL e token do serviço já conectado ao WhatsApp no Render.
WHATSAPP_SERVICE_URL=https://seu-servico.onrender.com
WHATSAPP_SERVICE_TOKEN=defina-o-mesmo-token-do-render

# O Neon conectado pela Vercel fornece automaticamente uma dessas variáveis.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Login da área administrativa. Não use a senha da conta Google.
ESSENCE_ADMIN_PASSWORD=crie-uma-senha-forte-exclusiva-para-o-site
ESSENCE_ADMIN_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio
